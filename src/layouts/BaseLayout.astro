---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  active: "home" | "about" | "runners" | "results";
}

const { title, description, active } = Astro.props;
const base = import.meta.env.BASE_URL;

const currentYear = 2026;
const navItems = [
  { label: "Home", href: base, key: "home" },
  { label: "About the Race", href: `${base}about/`, key: "about" },
  { label: "Runner Information", href: `${base}runners/`, key: "runners" },
  { label: "History & Results", href: `${base}results/`, key: "results" },
] as const;
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href={base}>ANU Inward Bound</a>
      <nav class="desktop-nav" aria-label="Primary">
        {
          navItems.map((item) => (
            <a href={item.href} aria-current={active === item.key ? "page" : undefined}>{item.label}</a>
          ))
        }
        <a class="external-link" href="https://live.anuinwardbound.com/" rel="noopener">IB Live</a>
      </nav>
      <details class="mobile-nav">
        <summary>Menu</summary>
        <nav aria-label="Primary mobile">
          {
            navItems.map((item) => (
              <a href={item.href} aria-current={active === item.key ? "page" : undefined}>{item.label}</a>
            ))
          }
          <a href="https://live.anuinwardbound.com/" rel="noopener">IB Live</a>
        </nav>
      </details>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <address>ANU Inward Bound, Australian National University, Canberra ACT</address>
      <p class="footer-links">
        <a href="https://anuinwardbound.com/" rel="noopener">Official site</a>
        <a href="https://www.facebook.com/Inward.Bound62" rel="noopener">Facebook</a>
        <a href="https://www.instagram.com/inwardbound/" rel="noopener">Instagram</a>
      </p>
      <p>
        &copy; {currentYear} ANU Inward Bound. Unofficial redesign concept, built as a COMP4020
        studio exercise.
      </p>
    </footer>
  </body>
</html>
