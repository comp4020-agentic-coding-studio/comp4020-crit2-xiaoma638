---
import BaseLayout from "../../layouts/BaseLayout.astro";

const years = [
  {
    year: 2024,
    endpoint: "Honeysuckle Creek Tracking Station",
    winner: "Bruce Hall",
    summary: "First individual win at Inward Bound in 42 years.",
  },
  {
    year: 2023,
    endpoint: "Humes Crossing Campground",
    winner: "B&G",
    summary: "B&G took overall honours.",
  },
  {
    year: 2022,
    endpoint: "Course rescheduled after flooding",
    winner: "B&G",
    summary: "Run after flooding forced a reschedule and two years cancelled by COVID-19.",
  },
  {
    year: 2019,
    endpoint: "Woolcara",
    winner: "B&G",
    summary: "First year the Wright and Wamburun divisions ran.",
  },
  {
    year: 2018,
    endpoint: "Not separately recorded here",
    winner: "—",
    summary: "Described by past organiser Jackson Bursill as “the Greatest Hits of IB.”",
  },
];
---

<BaseLayout
  title="History & Results — Inward Bound"
  description="Inward Bound results by year, including Endpoints and overall winners from 2018 to 2024, with links to official results and IB Live."
  active="results"
>
  <section>
    <h1>History &amp; Results</h1>
    <p>
      A quick look back at recent races. Each card links to the official result page for the
      full breakdown — this page only lists what's been confirmed publicly, not every division
      result from every year.
    </p>
  </section>

  <section aria-label="Results by year">
    <h2>By Year</h2>
    <div class="category-grid">
      {
        years.map((entry) => (
          <article class="event-card">
            <h3>{entry.year}</h3>
            <dl>
              <dt>Endpoint</dt>
              <dd>{entry.endpoint}</dd>
              <dt>Overall winner</dt>
              <dd>{entry.winner}</dd>
            </dl>
            <p>{entry.summary}</p>
            <a class="text-link" href="https://anuinwardbound.com/" rel="noopener">
              Official result page →
            </a>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-label="Follow live" class="join-cta">
    <h2>Following This Year's Race</h2>
    <p>
      For the current race weekend, live updates and archived race-weekend content are on IB
      Live.
    </p>
    <a class="button button-primary" href="https://live.anuinwardbound.com/" rel="noopener"
      >Open IB Live</a
    >
  </section>
</BaseLayout>
