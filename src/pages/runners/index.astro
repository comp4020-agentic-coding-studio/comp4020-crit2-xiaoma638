---
import BaseLayout from "../../layouts/BaseLayout.astro";

const verifiedDate = "6 August 2026";

const externalLinks = [
  {
    title: "Race Rules",
    detail: "Full current-year rules, eligibility conditions and divisions.",
    href: "https://anuinwardbound.com/",
  },
  {
    title: "Required Gear",
    detail: "The mandatory gear list for runners and navigators.",
    href: "https://anuinwardbound.com/",
  },
  {
    title: "First Aid & Safety",
    detail: "Safety briefings and first-aid requirements for race weekend.",
    href: "https://anuinwardbound.com/",
  },
];
---

<BaseLayout
  title="Runner Information — Inward Bound"
  description="What to know before running Inward Bound: who can take part, navigator requirements, and where to find current rules, gear and safety information."
  active="runners"
>
  <section>
    <h1>Runner Information</h1>
    <p>
      This page consolidates what runners need before race day. Rules, fees and required gear
      change year to year, so specifics live on the official site — this page links straight to
      them rather than restating numbers that could be out of date.
    </p>
  </section>

  <section aria-label="Who can participate">
    <h2>Who Can Take Part</h2>
    <p>
      Inward Bound is run in teams of four, across several divisions catering to different
      experience levels — divisions such as Wright and Wamburun have featured in past races. For
      the current year's divisions and eligibility conditions, see the official Race Rules below.
    </p>
  </section>

  <section aria-label="Navigator requirements">
    <h2>Navigator Requirements</h2>
    <p>
      Each team needs at least one qualified navigator. To qualify, a navigator must complete at
      least one bush-based rogaine of five hours or more, meeting a minimum score requirement —
      teams entering Divisions 1–3 need an additional qualifying rogaine. Confirm current
      qualifying events and score thresholds on the official site before you rely on this.
    </p>
  </section>

  <section aria-label="Official documents">
    <h2>Official Documents &amp; Links</h2>
    <p>Verified against anuinwardbound.com on {verifiedDate}. Always check the live page for the current year.</p>
    <div class="entry-cards">
      {
        externalLinks.map((link) => (
          <a class="card" href={link.href} rel="noopener">
            <h3>{link.title}</h3>
            <p>{link.detail}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-label="Contact" class="join-cta">
    <h2>Ready to enter a team?</h2>
    <p>
      Key dates, fees and team nomination are handled on the official Inward Bound site — this
      page does not process entries.
    </p>
    <address>ANU Inward Bound, Australian National University, Canberra ACT</address>
    <div class="hero-actions">
      <a class="button button-primary" href="https://anuinwardbound.com/" rel="noopener"
        >anuinwardbound.com</a
      >
      <a class="button button-outline" href="https://www.facebook.com/Inward.Bound62" rel="noopener"
        >Facebook</a
      >
    </div>
  </section>
</BaseLayout>
