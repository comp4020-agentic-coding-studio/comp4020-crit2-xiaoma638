---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;

const keyFacts = [
  { value: "30–100km", label: "unsupported, team to Endpoint" },
  { value: "4", label: "runners per team" },
  { value: "60+", label: "years of Inward Bound" },
];

const pathways = [
  {
    title: "Run",
    summary: "Put a team of four together and take on the course.",
    detail:
      "See who can take part, what a navigator needs, and what to check before you commit a team.",
    href: `${base}runners/`,
    cta: "Runner Information",
  },
  {
    title: "Volunteer",
    summary: "Inward Bound runs on volunteers, from Dropsite to Endpoint.",
    detail:
      "The event only happens because people give up a weekend to run it. Get in touch to find out how to help.",
    href: `${base}about/`,
    cta: "About the Race",
  },
  {
    title: "Follow",
    summary: "Track teams live as they navigate towards Endpoint.",
    detail: "IB Live carries live updates during the race weekend itself.",
    href: "https://live.anuinwardbound.com/",
    cta: "Open IB Live",
    external: true,
  },
];
---

<BaseLayout
  title="Inward Bound — ANU Team Navigation & Endurance Race"
  description="Inward Bound is an ANU team navigation and endurance race through the Australian wilderness: dropped blindfolded, teams of four navigate to a secret Endpoint."
  active="home"
>
  <section class="hero motif-contours">
    <h1>Dropped blindfolded.<br />Navigate the unknown.<br />Find Endpoint.</h1>
    <p class="lede">
      Inward Bound is an ANU team navigation and endurance race through the Australian
      wilderness. Teams of four are transported to an unknown location, then find their own way
      — unsupported — to a secret finish line.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href={`${base}about/`}>How It Works</a>
      <a class="button button-ghost" href={`${base}runners/`}>Runner Information</a>
    </div>
  </section>

  <section aria-label="Key facts">
    <dl class="key-facts">
      {
        keyFacts.map((fact) => (
          <div>
            <dt>{fact.value}</dt>
            <dd>{fact.label}</dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section aria-label="Get involved">
    <h2>Find your way in</h2>
    <hr class="route-divider" aria-hidden="true" />
    <div class="entry-cards">
      {
        pathways.map((path) => (
          <a class="card" href={path.href} rel={path.external ? "noopener" : undefined}>
            <h3>{path.title}</h3>
            <p>{path.summary}</p>
            <p>{path.detail}</p>
          </a>
        ))
      }
    </div>
  </section>

  <section aria-label="Recent results">
    <h2>History &amp; Results</h2>
    <div class="event-card">
      <h3>2024 — Endpoint: Honeysuckle Creek Tracking Station</h3>
      <p>
        Bruce Hall won overall in 2024 — the first individual win at Inward Bound in 42 years.
      </p>
      <a class="text-link" href={`${base}results/`}>See History &amp; Results →</a>
    </div>
  </section>

  <section aria-label="About the organisation" class="join-cta">
    <h2>Run by ANU students, since the 1960s</h2>
    <p>
      Inward Bound is organised by ANU students and volunteers, supported by ANU Sport. Read more
      on the official site, or follow along on IB Live during race weekend.
    </p>
    <div class="hero-actions">
      <a class="button button-primary" href="https://anuinwardbound.com/" rel="noopener"
        >anuinwardbound.com</a
      >
      <a class="button button-outline" href="https://live.anuinwardbound.com/" rel="noopener"
        >IB Live</a
      >
    </div>
  </section>
</BaseLayout>
