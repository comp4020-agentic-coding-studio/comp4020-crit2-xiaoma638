---
import BaseLayout from "../layouts/BaseLayout.astro";

const base = import.meta.env.BASE_URL;
---

<BaseLayout
  title="Canberra Runners — Run Canberra Together"
  description="Canberra Runners is a local running club with events, training programs and social runs for every pace and experience level."
  active="home"
>
  <section class="hero">
    <h1>Run Canberra Together</h1>
    <p class="lede">Events, training and social runs for every pace and experience level.</p>
    <div class="hero-actions">
      <a class="button button-primary" href={`${base}events/`}>Find an Event</a>
      <a class="button button-ghost" href={`${base}training/`}>Start Training</a>
    </div>
  </section>

  <section aria-label="Get started">
    <div class="entry-cards">
      <a class="card" href={`${base}events/#social`}>
        <h2>Social Runs</h2>
        <p>Run with a welcoming local group and meet runners from across Canberra.</p>
      </a>
      <a class="card" href={`${base}events/`}>
        <h2>Events</h2>
        <p>Discover races ranging from short community events to half marathons and endurance challenges.</p>
      </a>
      <a class="card" href={`${base}training/`}>
        <h2>Training</h2>
        <p>Build confidence with programs for first-time 5K runners through to experienced half-marathon runners.</p>
      </a>
    </div>
  </section>

  <section>
    <h2>Upcoming Runs</h2>
    <ul class="event-list">
      <li>
        <span class="event-name">Half Marathon &amp; 10km</span>
        <span class="event-meta">Sun 17 May 2026 · Lennox Gardens</span>
      </li>
      <li>
        <span class="event-name">Capital to Coast</span>
        <span class="event-meta">28–30 Aug 2026 · Canberra to the South Coast</span>
      </li>
      <li>
        <span class="event-name">Thredbo Fun &amp; Fitness Week</span>
        <span class="event-meta">10–17 Jan 2026 · Thredbo</span>
      </li>
    </ul>
    <a class="text-link" href={`${base}events/`}>See all events →</a>
  </section>

  <section>
    <h2>Why Run With Us</h2>
    <ul class="why-list">
      <li>Weekly group runs at Lennox Gardens, every pace welcome</li>
      <li>Structured programs from your first 5K to your first half marathon</li>
      <li>A social club as much as a running one — coffee after, always</li>
    </ul>
  </section>

  <section class="join-cta">
    <h2>Join Canberra Runners</h2>
    <p>Membership gets you member pricing on every event, plus the weekly group runs.</p>
    <a class="button button-primary" href={`${base}about/#join`}>Join Canberra Runners</a>
  </section>
</BaseLayout>
